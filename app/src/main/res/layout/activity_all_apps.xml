<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712">

    <!-- Scenic Nature Backdrop with Dark Tint -->
    <ImageView
        android:id="@+id/imgDrawerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_nature_1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3030712" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <FrameLayout
                android:id="@+id/btnBackFromDrawer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_drawer_grid_item"
                android:focusable="true"
                android:clickable="true"
                android:layout_marginEnd="18dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALL APPLICATIONS"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtAppCountHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 APPS INSTALLED"
                android:textColor="#88FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />
        </LinearLayout>

        <!-- 5-Column TV App Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAllAppsGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false" />
    </LinearLayout>
</FrameLayout>
